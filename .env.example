# Vorlage: kopieren nach .env (bzw. Werte in Dockhand als Stack-Env-Variablen hinterlegen)

# Domain, unter der n8n erreichbar sein soll (A-Record auf die VPS-IP,
# Proxy Host im Nginx Proxy Manager)
N8N_HOST=n8n.deine-domain.de

# Verschlüsselungskey für die in n8n gespeicherten Credentials.
# EINMAL generieren und danach NIE mehr ändern:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=HIER-GENERIERTEN-KEY-EINTRAGEN

# PostgreSQL
DB_USER=n8n
DB_NAME=n8n
DB_PASSWORD=HIER-SICHERES-PASSWORT-EINTRAGEN

# Nur bei Nutzung von docker-compose.proxy.yml: Docker-Netz des Reverse Proxys
# (herausfinden mit: docker network ls)
PROXY_NETWORK=proxy

# Zeitzone (steuert u.a. die Schedule-Trigger)
TZ=Europe/Berlin

# ─── Mail-Panel ──────────────────────────────────────────────────────────────
# Alle drei Secrets generieren mit: openssl rand -hex 32
JWT_SECRET=HIER-GENERIERTEN-KEY-EINTRAGEN
# Shared Secret, mit dem die n8n-Workflows die internen Panel-Endpunkte aufrufen
PANEL_SECRET=HIER-GENERIERTEN-KEY-EINTRAGEN
# Schluessel fuer die AES-Verschluesselung der Konto-Passwoerter in der Panel-DB
PANEL_DB_KEY=HIER-GENERIERTEN-KEY-EINTRAGEN

# n8n-API-Key: in n8n unter Settings -> n8n API erzeugen
N8N_API_KEY=HIER-EINTRAGEN

# Mailcow: Basis-URL und Admin-API-Key (Read-Write, IP-beschraenkt)
MAILCOW_URL=https://mail.deine-domain.de
MAILCOW_API_KEY=HIER-EINTRAGEN

# Google Safe Browsing (kostenloser API-Key aus der Google Cloud Console)
SAFEBROWSING_API_KEY=HIER-EINTRAGEN
