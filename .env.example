# Vorlage: kopieren nach .env (bzw. Werte in Dockhand als Stack-Env-Variablen hinterlegen)

# Domain, unter der n8n erreichbar sein soll (A-Record auf die VPS-IP,
# Proxy Host im Nginx Proxy Manager)
N8N_HOST=n8n.deine-domain.de

# Verschlüsselungskey für die in n8n gespeicherten Credentials.
# EINMAL generieren und danach NIE mehr ändern:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=HIER-GENERIERTEN-KEY-EINTRAGEN

# PostgreSQL
DB_USER=n8n
DB_NAME=n8n
DB_PASSWORD=HIER-SICHERES-PASSWORT-EINTRAGEN

# Docker-Netz des Nginx Proxy Managers (docker network ls)
NPM_NETWORK=npm_default

# Zeitzone (steuert u.a. die Schedule-Trigger)
TZ=Europe/Berlin
