                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "// Quelle für den Sammel-Knoten in Workflow 04 (wird als jsCode eingebettet).\n// Holt die Mails aller Konten zusammen und bereitet sie wie in Workflow 01 auf.\n\n// Die Quellenliste pflegt das Mail-Panel — der Bereich zwischen den Markern\n// wird bei jedem Konto-Sync neu geschrieben.\nconst quellen = [\n// PANEL:QUELLEN-START\n// PANEL:QUELLEN-ENDE\n];\n\nfunction safeAll(name) {\n  try { return $(name).all().filter((i) =\u003e i.json \u0026\u0026 Object.keys(i.json).length \u003e 0); }\n  catch (e) { return []; }\n}\n\nfunction absenderIp(j, h) {\n  let received = h.received || h.Received;\n  if (!received \u0026\u0026 Array.isArray(j.headerLines)) {\n    received = j.headerLines\n      .filter((z) =\u003e String(z.key || \u0027\u0027).toLowerCase() === \u0027received\u0027)\n      .map((z) =\u003e z.line);\n  }\n  if (!received) return null;\n  const zeilen = Array.isArray(received) ? received : [received];\n  const intern = /^(10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|0\\.)/;\n  for (const zeile of zeilen) {\n    const gefunden = String(zeile).match(/\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b/g) || [];\n    const treffer = gefunden.find((ip) =\u003e !intern.test(ip));\n    if (treffer) return treffer;\n  }\n  return null;\n}\n\nfunction normalisieren(j, konto) {\n  const e = j.envelope || {};\n  const h = j.headers || {};\n\n  const von = (e.from \u0026\u0026 e.from[0] \u0026\u0026 e.from[0].address)\n    || (j.from \u0026\u0026 j.from.value \u0026\u0026 j.from.value[0] \u0026\u0026 j.from.value[0].address)\n    || (j.from \u0026\u0026 j.from.text)\n    || (typeof j.from === \u0027string\u0027 ? j.from : \u0027\u0027)\n    || \u0027\u0027;\n  const betreff = e.subject || j.subject || j.Subject || \u0027(kein Betreff)\u0027;\n\n  let volltext = j.textContent || j.textPlain || j.text || j.snippet || j.textHtml || \u0027\u0027;\n  if (typeof volltext !== \u0027string\u0027) volltext = JSON.stringify(volltext);\n\n  const links = [...new Set((volltext.match(/https?:\\/\\/[^\\s\u003c\u003e\"\u0027)\\]]+/gi) || []))].slice(0, 20);\n  const listUnsubscribe = h[\u0027list-unsubscribe\u0027]\n    || (h.list \u0026\u0026 h.list.unsubscribe \u0026\u0026 (h.list.unsubscribe.url || h.list.unsubscribe.id))\n    || null;\n\n  const text = volltext.replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 1500);\n\n  const promptText = `Du bist ein E-Mail-Klassifizierer. Analysiere die folgende E-Mail und antworte NUR mit einem JSON-Objekt in exakt diesem Format:\n{\"kategorie\": \"spam|rechnung|bestellung|newsletter|persoenlich|sonstiges\", \"spam_score\": 0.0, \"kurzfassung\": \"Ein Satz Zusammenfassung auf Deutsch\"}\n\nRegeln:\n- spam_score: 0.0 (sicher kein Spam) bis 1.0 (sicher Spam). Phishing, Betrugsversuche, unserioese Werbung = hoher Score.\n- kategorie \"rechnung\": Rechnungen, Zahlungsaufforderungen, Kontoauszuege, Vertraege.\n- kategorie \"bestellung\": Bestell-/Versandbestaetigungen, Lieferstatus.\n- kategorie \"newsletter\": Newsletter und Marketing serioeser Absender.\n- kategorie \"persoenlich\": Mails von echten Menschen (privat oder geschaeftlich).\n- Alles andere: \"sonstiges\".\n\nE-Mail:\nVon: ${von}\nBetreff: ${betreff}\nText: ${text}`;\n\n  return {\n    konto,\n    // Der IMAP-Trigger legt die UID unter attributes ab, der Abruf-Knoten\n    // direkt daneben — ohne sie kann später nichts verschoben werden.\n    uid: j.uid ?? j.attributes?.uid ?? null,\n    // Für den Virenscan: Der Abruf-Knoten liefert nur die Namen der Anhänge,\n    // die Dateien holt sich das Panel später selbst über die UID.\n    hat_anhang: Array.isArray(j.attachmentsInfo) \u0026\u0026 j.attachmentsInfo.length \u003e 0,\n    id: j.id ?? null,\n    von,\n    betreff,\n    ip: absenderIp(j, h),\n    links,\n    listUnsubscribe: typeof listUnsubscribe === \u0027string\u0027 ? listUnsubscribe : null,\n    promptText,\n  };\n}\n\nconst out = [];\nfor (const [konto, nodeName] of quellen) {\n  for (const item of safeAll(nodeName)) {\n    const mail = normalisieren(item.json, konto);\n    // Knoten ohne Zugangsdaten liefern\n    // Platzhalter-Items ohne Absender — die sind keine Mail und fliegen raus.\n    if (!mail.von) continue;\n    out.push({ json: mail });\n  }\n}\n\nif (out.length === 0) {\n  // Nichts zu tun heisst: keine Items. Ein Hinweis-Item liefe als Schein-Mail\n  // durch die ganze Kette und kostete am Ende eine KI-Abfrage mit leerem Text.\n  return [];\n}\nreturn out;\n"
                                     },
