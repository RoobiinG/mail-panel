                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "// Ergebnis der Panel-Prüfung mit der Mail zusammenführen.\n// Whitelist beendet die Prüfung sofort, Blacklist geht ohne KI in die Quarantäne.\nconst mail = $(\u0027Normalisieren\u0027).item.json;\nconst p = $json || {};\n\nconst entscheidung = p.entscheidung || \u0027weiter\u0027;\nconst gruende = Array.isArray(p.gruende) ? p.gruende : [];\n\nreturn {\n  json: {\n    ...mail,\n    entscheidung,\n    score_aufschlag: Number(p.score_aufschlag) || 0,\n    spam_schwellwert: Number(p.spam_schwellwert) || 0.8,\n    gruende,\n    dnsbl_treffer: p.dnsbl_treffer || [],\n    // Blacklist braucht keine KI-Abfrage mehr\n    direkt_quarantaene: entscheidung === \u0027quarantaene\u0027,\n    // Whitelist übersteuert später auch die KI-Bewertung\n    nie_quarantaene: entscheidung === \u0027freigeben\u0027,\n  },\n  // Anhaenge weiterreichen — der HTTP-Knoten davor wirft sie weg\n};\n"
                                     },
